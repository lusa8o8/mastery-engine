      "type": "string"
    },
    "aggregate_id": {
      "format": "uuid",
      "title": "Aggregate Id",
      "type": "string"
    },
    "event_type": {
      "pattern": "^[a-z][a-z0-9_.-]{2,63}$",
      "title": "Event Type",
      "type": "string"
    },

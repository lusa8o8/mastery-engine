{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "command.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "command_id": {
      "format": "uuid",
      "title": "Command Id",
      "type": "string"
    },
    "command_type": {
      "pattern": "^[a-z][a-z0-9_.-]{2,63}$",
      "title": "Command Type",
      "type": "string"
    },
    "principal_id": {
      "format": "uuid",
      "title": "Principal Id",
      "type": "string"
    },
    "tenant_id": {
      "format": "uuid",
      "title": "Tenant Id",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "payload_schema_version": {
      "pattern": "^[a-z][a-z0-9_.-]+\\.v[1-9][0-9]*$",
      "title": "Payload Schema Version",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "requested_at": {
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "command_id",
    "command_type",
    "principal_id",
    "tenant_id",
    "idempotency_key",
    "payload_schema_version",
    "payload",
    "requested_at"
  ],
  "title": "CommandEnvelope",
  "type": "object",
  "$id": "https://schemas.atlas.local/s2a/command.v1.schema.json"
}

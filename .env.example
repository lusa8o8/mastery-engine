# Atlas / Mastery Engine environment template
# Copy this file to .env or .env.local and replace every placeholder.
# Never commit populated secret values.

# -----------------------------------------------------------------------------
# Vite client configuration
# These values are bundled into the browser. The Supabase anon key is designed
# to be public, but database access must still be protected with correct RLS.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# -----------------------------------------------------------------------------
# Supabase Edge Function secrets (server-side only; never prefix with VITE_)
# Used by atlas-chat, atlas-extract, and atlas-variant.
# Configure deployed values with `supabase secrets set`, or provide this file to
# `supabase functions serve --env-file .env` for local function development.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Local administrative tooling only (for example, the S0 restore rehearsal).
# Never expose this through Vite or commit a populated value.
SUPABASE_DB_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD
